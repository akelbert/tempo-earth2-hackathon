# syntax=docker/dockerfile:1.7
#
# Earth-2 Lab, CPU development variant.
#
# This is NOT the attendee image. It exists so the notebooks can be developed
# and reviewed on a laptop - specifically an Apple Silicon Mac, where the real
# image is useless: its base is ~20 GB of CUDA that has no device to run on.
#
# Differences from docker/Dockerfile, all deliberate:
#   * base is python:3.13-slim rather than nvcr.io/nvidia/pytorch, so it builds
#     natively on arm64 in minutes instead of pulling 20 GB;
#   * torch comes from the CPU wheel index, so there is no CUDA at all;
#   * the layout, environment variables, entrypoint and recovery commands are
#     identical, so anything you learn about the workflow here transfers.
#
# What it can tell you: whether the notebooks run, whether the widgets render,
# whether the Glue viewers behave in a browser, whether the seeding and recovery
# commands work.
#
# What it cannot tell you: anything about GPU memory, inference time, CUDA
# compatibility, or the NGC dependency resolution. Those need the real image on
# an amd64 GPU host.
#
#   docker build -f docker/Dockerfile.cpu -t earth2-lab:cpu .

FROM python:3.13-slim-bookworm

LABEL org.opencontainers.image.title="Earth-2 Lab (CPU dev)" \
      org.opencontainers.image.description="CPU-only development variant of the TEMPO x Earth-2 workshop image"

ARG EARTH2STUDIO_VERSION=0.17.0
ARG NB_USER=jovyan
ARG NB_UID=1000
ARG NB_GID=100

# Installing Earth2Studio roughly triples the build time and image size. It is
# on by default because the point of this image is to exercise the real
# notebook; set to false for a fast notebook-layout iteration loop.
ARG WITH_EARTH2STUDIO=true

ENV DEBIAN_FRONTEND=noninteractive \
    SHELL=/bin/bash \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# eccodes backs pygrib (GFS initial conditions); geos/proj back cartopy. Both
# have arm64 packages in Debian, which is why this builds natively.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libeccodes-dev \
        libeccodes-tools \
        libgeos-dev \
        libhdf5-dev \
        libnetcdf-dev \
        libproj-dev \
        proj-bin \
        rsync \
        tini \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/
ENV UV_CACHE_DIR=/opt/uv-cache \
    UV_LINK_MODE=copy

# torch from the CPU index. Note: on linux/aarch64 this still resolves to a
# CUDA-tagged build (2.13.0+cu130) because PyTorch targets Grace/GH200 there and
# no CPU-only aarch64 Linux wheel is published. It reports
# torch.cuda.is_available() == False on a Mac, which is what matters here, but
# it is why this image is ~7.8 GB rather than ~2 GB. On amd64 the index does
# what it says and yields a genuinely CPU-only build.
RUN --mount=type=cache,target=/opt/uv-cache,sharing=locked \
    uv pip install --system --break-system-packages \
        --index-url https://download.pytorch.org/whl/cpu \
        --extra-index-url https://pypi.org/simple \
        torch

COPY docker/requirements-lab.txt /tmp/requirements-lab.txt
RUN --mount=type=cache,target=/opt/uv-cache,sharing=locked \
    uv pip install --system --break-system-packages -r /tmp/requirements-lab.txt \
    && rm /tmp/requirements-lab.txt

RUN --mount=type=cache,target=/opt/uv-cache,sharing=locked \
    if [ "${WITH_EARTH2STUDIO}" = "true" ]; then \
        uv pip install --system --break-system-packages \
            "earth2studio[fcn,data,utils] @ git+https://github.com/NVIDIA/earth2studio.git@${EARTH2STUDIO_VERSION}"; \
    fi

RUN python -c "import torch, jupyterhub, jupyterlab, glue_jupyter, xarray, cartopy, scipy; \
print('torch', torch.__version__, '(cuda:', torch.cuda.is_available(), ')'); \
print('jupyterhub', jupyterhub.__version__)" \
 && (python -c "import earth2studio; print('earth2studio', earth2studio.__version__)" \
     || echo 'earth2studio not installed (WITH_EARTH2STUDIO=false)')

# Layout identical to the attendee image.
ENV EARTH2_ROOT=/opt/earth2 \
    WORKSHOP_REFERENCE_DIR=/opt/earth2/notebooks \
    WORKSHOP_PRECOMPUTED=/opt/earth2/precomputed \
    WORKSHOP_WORK_DIR=/home/${NB_USER}/work \
    EARTH2STUDIO_MODEL_CACHE=/opt/earth2/cache/models \
    EARTH2STUDIO_DATA_CACHE=/home/${NB_USER}/.cache/earth2studio/data \
    EARTH2STUDIO_PACKAGE_TIMEOUT=900 \
    PYTHONPATH=/opt/earth2/lib \
    PATH=/opt/earth2/bin:/home/${NB_USER}/.local/bin:${PATH} \
    MPLCONFIGDIR=/tmp/matplotlib

RUN mkdir -p /opt/earth2/notebooks /opt/earth2/cache/models \
             /opt/earth2/precomputed /opt/earth2/bin /opt/earth2/lib /opt/earth2/scripts

COPY src/tempo_earth2 /opt/earth2/lib/tempo_earth2
COPY notebooks/*.ipynb /opt/earth2/notebooks/
COPY scripts/ /opt/earth2/scripts/
COPY docker/bin/ /opt/earth2/bin/

RUN chmod -R a+rx /opt/earth2/bin \
    && python -c "import tempo_earth2; print('tempo_earth2', tempo_earth2.__version__)"

# A JupyterLab terminal starts a *login* shell, and /etc/profile rebuilds PATH
# from scratch - discarding the ENV PATH set above. Without this, the recovery
# commands are "command not found" at exactly the moment an attendee has been
# told to run one. Verified by `make verify-shell`.
RUN printf '%s\n' \
      '# Earth-2 Lab: keep the workshop commands reachable in login shells.' \
      'export PATH="/opt/earth2/bin:$HOME/.local/bin:$PATH"' \
      > /etc/profile.d/earth2-lab.sh \
    && chmod 0644 /etc/profile.d/earth2-lab.sh

RUN useradd --create-home --uid ${NB_UID} --gid ${NB_GID} --shell /bin/bash ${NB_USER} \
    && mkdir -p /home/${NB_USER}/work /home/${NB_USER}/.cache/earth2studio/data \
    && chown -R ${NB_UID}:${NB_GID} /home/${NB_USER} \
    && chmod -R a+rX /opt/earth2

COPY docker/entrypoint.sh /usr/local/bin/earth2-entrypoint
RUN chmod +x /usr/local/bin/earth2-entrypoint

USER ${NB_UID}:${NB_GID}
WORKDIR /home/${NB_USER}
ENV HOME=/home/${NB_USER}

EXPOSE 8888

ENTRYPOINT ["tini", "-g", "--", "/usr/local/bin/earth2-entrypoint"]
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--no-browser", "--ServerApp.token="]
