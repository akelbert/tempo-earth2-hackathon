#!/usr/bin/env bash
# Seed the released notebooks into the attendee home, once.
#
# Copies the immutable reference set into ${WORKSHOP_WORK_DIR}/notebooks the
# first time a given release is seen, and records the release so later starts
# are no-ops. Attendee edits are never overwritten; use
# restore-workshop-notebooks to get a clean copy of a single notebook back.
set -euo pipefail

: "${WORKSHOP_REFERENCE_DIR:=/opt/earth2/notebooks}"
: "${WORKSHOP_WORK_DIR:=${HOME}/work}"
: "${WORKSHOP_RELEASE:=unversioned}"

target="${WORKSHOP_WORK_DIR}/notebooks"
stamp="${WORKSHOP_WORK_DIR}/.seeded-${WORKSHOP_RELEASE}"

if [ ! -d "${WORKSHOP_REFERENCE_DIR}" ]; then
    echo "[seed] no reference notebooks at ${WORKSHOP_REFERENCE_DIR}" >&2
    exit 0
fi

if [ -f "${stamp}" ]; then
    exit 0
fi

mkdir -p "${target}"

# The September release reordered the notebook path. Existing persistent homes
# may contain the former filenames; leaving them in place would show users two
# copies of every lesson. Preserve any such files (including attendee edits) in
# the recovery area before seeding the newly numbered reference copies.
old_names=(
    01_tempo_earth2_intro.ipynb
    02_tempo_column_vs_surface.ipynb
    03_smoke_event.ipynb
    04_wetland_response.ipynb
    05_scale_matters.ipynb
    06_bring_your_own_site.ipynb
    07_earth2_model_tasting_menu.ipynb
    08_tempo_earth2_toolkit_tour.ipynb
)
new_names=(
    04_tempo_earth2_intro.ipynb
    05_tempo_column_vs_surface.ipynb
    06_smoke_event.ipynb
    07_wetland_response.ipynb
    08_scale_matters.ipynb
    09_bring_your_own_site.ipynb
    03_earth2_model_tasting_menu.ipynb
    02_tempo_earth2_toolkit_tour.ipynb
)
migration_backup="${WORKSHOP_WORK_DIR}/.recovered/$(date -u +%Y%m%dT%H%M%SZ)-renumbering"

for index in "${!old_names[@]}"; do
    old_name="${old_names[index]}"
    new_name="${new_names[index]}"
    if [ -e "${target}/${old_name}" ] && [ -e "${WORKSHOP_REFERENCE_DIR}/${new_name}" ]; then
        mkdir -p "${migration_backup}"
        mv "${target}/${old_name}" "${migration_backup}/${old_name}"
        echo "[seed] preserved superseded ${old_name} in ${migration_backup}" >&2
    fi
done

# --ignore-existing is what makes this safe to run on every start: new notebooks
# from a later release appear, edited notebooks are left alone.
rsync -a --ignore-existing \
    --exclude '.ipynb_checkpoints' \
    "${WORKSHOP_REFERENCE_DIR}/" "${target}/"

date -u +%Y-%m-%dT%H:%M:%SZ > "${stamp}"
echo "[seed] workshop notebooks seeded into ${target} (release ${WORKSHOP_RELEASE})" >&2
