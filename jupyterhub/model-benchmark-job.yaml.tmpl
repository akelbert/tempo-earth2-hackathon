apiVersion: batch/v1
kind: Job
metadata:
  name: "${JOB_NAME}"
  namespace: "${NAMESPACE}"
  labels:
    app.kubernetes.io/name: earth2-model-benchmark
    app.kubernetes.io/part-of: tempo-earth2
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: earth2-model-benchmark
    spec:
      restartPolicy: Never
      serviceAccountName: "${KUBERNETES_SERVICE_ACCOUNT}"
      nodeSelector:
        workload: jupyter-gpu
      tolerations:
        - key: workload
          operator: Equal
          value: jupyter-gpu
          effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 100
        fsGroup: 100
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: benchmark
          image: "${CANDIDATE_IMAGE_DIGEST}"
          imagePullPolicy: IfNotPresent
          command: ["bash", "-ce", "--"]
          args:
            - |
              python /opt/earth2/scripts/benchmark_models.py \
                --model FCN DLWP \
                --init-time 2026-05-31T12:00 \
                --output /results/model-benchmark.json
              python /opt/earth2/scripts/benchmark_precipitation.py \
                --init-time 2026-05-31T12:00 \
                --output /results/precipitation-benchmark.json
              python -c 'import json; from pathlib import Path; prognostics=json.loads(Path("/results/model-benchmark.json").read_text())["records"]; precipitation=json.loads(Path("/results/precipitation-benchmark.json").read_text())["record"]; records=[*prognostics, precipitation]; assert all(record["status"] == "passed" for record in records), records; assert all(record["gpu"] == "NVIDIA L4" for record in records), records; assert all(record["cache_growth_gb"] == 0 for record in records), "release image downloaded a checkpoint at runtime"; print("Release gate passed: NVIDIA L4, successful inference, zero checkpoint-cache growth")'
              echo '=== model-benchmark.json ==='
              cat /results/model-benchmark.json
              echo '=== precipitation-benchmark.json ==='
              cat /results/precipitation-benchmark.json
          env:
            - name: EARTH2STUDIO_DATA_CACHE
              value: /cache/data
          resources:
            requests:
              cpu: "2"
              memory: 8Gi
              ephemeral-storage: 10Gi
              nvidia.com/gpu: "1"
            limits:
              cpu: "4"
              memory: 16Gi
              ephemeral-storage: 20Gi
              nvidia.com/gpu: "1"
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: cache
              mountPath: /cache
            - name: results
              mountPath: /results
      volumes:
        - name: cache
          emptyDir: {}
        - name: results
          emptyDir: {}
